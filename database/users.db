-- Apex Logistics Database (database/users.db)
-- SQLite Compatible Schema & Initial Seeds

CREATE TABLE IF NOT EXISTS users (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    username TEXT UNIQUE NOT NULL,
    full_name TEXT NOT NULL,
    role TEXT NOT NULL, -- 'dispatcher', 'customs_officer', 'customer'
    department TEXT NOT NULL,
    access_token TEXT NOT NULL,
    active_station TEXT NOT NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS parcels (
    parcel_id TEXT PRIMARY KEY,
    tracking_code TEXT UNIQUE NOT NULL,
    service_type TEXT NOT NULL,
    status TEXT NOT NULL, -- 'in_transit', 'on_hold', 'out_for_delivery', 'delivered'
    status_label TEXT NOT NULL,
    origin_city TEXT NOT NULL,
    origin_country TEXT NOT NULL,
    destination_city TEXT NOT NULL,
    destination_country TEXT NOT NULL,
    current_location TEXT NOT NULL,
    hold_location TEXT,
    hold_reason TEXT,
    hold_code TEXT,
    sender_name TEXT NOT NULL,
    recipient_name TEXT NOT NULL,
    weight_kg REAL NOT NULL,
    pieces INTEGER NOT NULL,
    estimated_delivery TEXT NOT NULL,
    last_updated DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS tracking_events (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    parcel_id TEXT NOT NULL,
    timestamp TEXT NOT NULL,
    location TEXT NOT NULL,
    status TEXT NOT NULL,
    description TEXT NOT NULL,
    officer_id TEXT,
    FOREIGN KEY(parcel_id) REFERENCES parcels(parcel_id)
);

